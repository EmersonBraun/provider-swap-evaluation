# At least two independent adapters are required for a live comparison.
# Never commit the populated file.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# Optional local provider. Start Ollama separately before the run.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Repeat live, non-deterministic runs to expose variance.
REPETITIONS=3

# A free-provider request that exceeds this limit is recorded as a timeout.
REQUEST_TIMEOUT_MS=25000
